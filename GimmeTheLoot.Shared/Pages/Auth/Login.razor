@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@inject ITokenStorage TokenStorage
@inject HttpClient Http
@inject NavigationManager NavManager
@inject JwtAuthenticationStateProvider JwtAuthStateProvider

<MudCard Class="mx-auto mt-6" Style="max-width:400px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>

        <EditForm Model="@loginModel" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="loginModel.Email" Label="Email" For="@(() => loginModel.Email)" Required="true" />

            <MudTextField @bind-Value="loginModel.Password" Label="Password" InputType="InputType.Password" For="@(() => loginModel.Password)" Required="true" />

            <MudButton Class="mt-4" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@IsBusy">Login</MudButton>
        </EditForm>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudText Color="Color.Error" Class="mt-2">@ErrorMessage</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    private LoginDTO loginModel = new();

    private bool IsBusy = false;
    private string? ErrorMessage;

    private async Task OnSubmit(EditContext context)
    {
        if (context.Validate())
            await LoginUser();
        else
            Console.WriteLine("Validation failed.");
    }

    private async Task LoginUser()
    {
        IsBusy = true;
        ErrorMessage = null;

        // 10.0.2.2 FOR ANDROID EMULATOR
        // NEED TO SET BASE URL IN PROGRAM.CS OF WEB AND MAUIPROGRAM.CS OF MOBILE
        var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var loginResult = await response.Content.ReadFromJsonAsync<LoginResult>();
            if (loginResult is not null)
            {
                await TokenStorage.SetTokenAsync(loginResult.Token);
                JwtAuthStateProvider.NotifyUserAuthentication(loginResult.Token);
                NavManager.NavigateTo("/");
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            ErrorMessage = $"Login failed: {error}";
        }

        IsBusy = false;
    }

    private record LoginResult(string Token);
}